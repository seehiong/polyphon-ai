# Polyphon Configuration

# Default output directory for transcripts, reports, and manifests
POLYPHON_OUTPUT_DIR=outputs

# Local LLM Serving Endpoint (OpenAI-compatible)
POLYPHON_LLM_ENDPOINT=http://127.0.0.1:8080/v1
POLYPHON_LLM_MODEL=qwen3.8-27b

# Seconds to wait for an LLM response (default 900). Summarising a long meeting
# on CPU or a small GPU can take several minutes; raise this if summaries fail
# with a timeout.
# POLYPHON_LLM_TIMEOUT=1800

# Maximum generation tokens for LLM summary (default 4096).
# POLYPHON_LLM_MAX_TOKENS=4096

# Hugging Face token for gated models (optional if logged in via huggingface-cli)
# HF_TOKEN=hf_...

# Optional comma-separated custom filler words/phrases to filter in Clean Verbatim mode
# POLYPHON_CUSTOM_FILLERS="you know,basically,like,right"

